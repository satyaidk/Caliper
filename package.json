{
  "name": "caliper",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Open a 3D model in the browser and measure it. Mesh, CAD and BIM formats, nothing uploaded.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satyaidk/Caliper.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register.mjs --test \"test/*.test.ts\""
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
